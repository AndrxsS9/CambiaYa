# Variables de entorno del backend — Marketplace de Intercambio
# Copia este archivo como .env y completa los valores reales

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-real
DJANGO_SETTINGS_MODULE=config.settings.dev

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Base de datos (solo para producción)
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# CORS (dominios permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Hosts permitidos (solo para producción)
ALLOWED_HOSTS=localhost,127.0.0.1
