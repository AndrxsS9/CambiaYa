# --- Python / Django ---
# Ignorar el entorno virtual
.venv/
env/
venv/
ENV/

# Ignorar base de datos local y entorno sensible
backend/.env
backend/db.sqlite3

# Cache y archivos compilados
__pycache__/
*.pyc
backend/__pycache__/
backend/*.pyc

# Archivos de media o estáticos locales
backend/staticfiles/
backend/media/

# --- React / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs de error de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Temporales ---
*.log
/tmp/
.temp/
